# ZenShield Environment Configuration
# Copy this file to .env and adjust variables as needed.

APP_NAME=ZenShield
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# SQLite Database Location
DATABASE_PATH=zenshield/data/ioc.db

# Optional External Reputation Services (Leave blank to use local SQLite only)
ENABLE_EXTERNAL_REPUTATION=false
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Detection Heuristic Thresholds
ENTROPY_HOSTNAME_THRESHOLD=3.8
ENTROPY_MIN_LENGTH=8
MAX_URL_LENGTH=150
MAX_HOSTNAME_LENGTH=40
MAX_SUBDOMAINS=3
MAX_HYPHENS_IN_DOMAIN=2
MAX_QUERY_PARAMS=5
