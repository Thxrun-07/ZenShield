# ==============================================================================
# ZenShield Unified Backend - Environment Configuration Template
# ==============================================================================
# All environment variables in ZenShield 2.0 use the ZENSHIELD_ prefix.
# For backward compatibility, unprefixed legacy variables are also supported.
#
# Migration Mapping:
#   HOST                    -> ZENSHIELD_HOST
#   PORT                    -> ZENSHIELD_PORT
#   DEBUG                   -> ZENSHIELD_DEBUG
#   APP_NAME                -> ZENSHIELD_APP_NAME
#   VIRUSTOTAL_API_KEY      -> ZENSHIELD_VIRUSTOTAL_API_KEY
#   SAFE_BROWSING_API_KEY   -> ZENSHIELD_SAFE_BROWSING_API_KEY
#   GROQ_API_KEY            -> ZENSHIELD_GROQ_API_KEY
#   DATABASE_URL            -> ZENSHIELD_DATABASE_URL
#   DATABASE_PATH           -> ZENSHIELD_DATABASE_PATH
#   ALLOWED_ORIGINS         -> ZENSHIELD_ALLOWED_ORIGINS
#   RATE_LIMIT_PER_MINUTE   -> ZENSHIELD_RATE_LIMIT_PER_MINUTE
# ==============================================================================

# --- Server & Core Configuration ---
ZENSHIELD_APP_NAME="ZenShield"
ZENSHIELD_APP_VERSION="2.0.0"
ZENSHIELD_ENVIRONMENT="development"
ZENSHIELD_DEBUG=false
ZENSHIELD_HOST="0.0.0.0"
ZENSHIELD_PORT=8000
ZENSHIELD_API_V1_PREFIX="/api/v1"

# --- Security & CORS ---
# Comma-separated list of allowed origins. Wildcard '*' disables allow_credentials automatically.
ZENSHIELD_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
ZENSHIELD_RATE_LIMIT_PER_MINUTE=120

# --- Request Body & Upload Size Limits ---
# Standard JSON payload limit (64 KB protects against DoS)
ZENSHIELD_MAX_REQUEST_BODY_BYTES=65536
# Multipart image upload limit for QR and OCR (10 MB)
ZENSHIELD_MAX_UPLOAD_SIZE_BYTES=10485760

# --- Database & Storage ---
# Unified SQLite / PostgreSQL database URL for threat IOCs and community reports
ZENSHIELD_DATABASE_URL="sqlite:///./zenshield.db"
# Fallback path for local SQLite IOC storage
ZENSHIELD_DATABASE_PATH="./data/ioc.db"

# --- URL Risk Engine Thresholds ---
ZENSHIELD_SHANNON_ENTROPY_THRESHOLD=4.2
ZENSHIELD_TYPOSQUATTING_DISTANCE_THRESHOLD=2

# --- External Threat Intelligence Providers ---
# VirusTotal API Key (leave empty or set to test key to disable external calls)
ZENSHIELD_VIRUSTOTAL_API_KEY=""
# Google Safe Browsing API Key (optional)
ZENSHIELD_SAFE_BROWSING_API_KEY=""
# Master toggle for outbound external reputation queries (false enforces pure static analysis)
ZENSHIELD_ENABLE_EXTERNAL_REPUTATION=false

# --- LLM Message Analysis (Groq) ---
# Optional secondary enricher for SMS/message semantic analysis
ZENSHIELD_GROQ_API_KEY=""
ZENSHIELD_GROQ_MODEL="llama-3.1-70b-versatile"
ZENSHIELD_ENABLE_LLM_ENRICHMENT=false

# --- OCR Configuration ---
# Path to Tesseract-OCR binary if not in system PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows, /usr/bin/tesseract on Linux)
ZENSHIELD_TESSERACT_CMD=""
