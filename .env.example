# ==============================================================================
# Zenshield Configuration Environment Variables
# ==============================================================================
# All configuration variables are prefixed with ZENSHIELD_.

# --- Operational & Resource Limits ---
ZENSHIELD_MAX_RAW_MESSAGE_LENGTH=10000
ZENSHIELD_MAX_POST_NORMALIZATION_LENGTH=10500
ZENSHIELD_MAX_REQUEST_BODY_BYTES=65536
ZENSHIELD_PERSIST_MESSAGE_CONTENT=false

# --- LLM Enrichment Settings ---
# Default provider is "noop" (zero external network calls, zero data egress).
# Options: "noop", "groq"
ZENSHIELD_LLM_PROVIDER=noop

# Enable server-side LLM enrichment flag (must be true for client enable_llm=true requests to execute)
ZENSHIELD_ENABLE_LLM_DEFAULT=false

# Base URL for OpenAI-compatible LLM endpoint (must use https:// and match allowlist)
ZENSHIELD_LLM_BASE_URL=https://api.groq.com/openai/v1

# Groq API key (REQUIRED if ZENSHIELD_ENABLE_LLM_DEFAULT=true and ZENSHIELD_LLM_PROVIDER=groq)
ZENSHIELD_LLM_API_KEY=

# Groq model name (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant)
ZENSHIELD_LLM_MODEL=llama-3.3-70b-versatile

# Strict timeout in seconds for LLM call (fail-safe fallback on timeout)
ZENSHIELD_LLM_TIMEOUT_SECONDS=1.5

# Maximum character count sent in masked payload to LLM
ZENSHIELD_MAX_LLM_PAYLOAD_LENGTH=1000
