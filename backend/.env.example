# RedFlag Cyber-Fraud & Phishing Alert Platform Configuration

# Server & Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration (Comma-separated list of allowed origin URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Tesseract OCR Executable Path Configuration (Windows Example)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# External Threat Intelligence API Keys (Placeholders - DO NOT COMMIT REAL KEYS)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
SAFE_BROWSING_API_KEY=your_google_safebrowsing_api_key_here

# Teammates' Detection Engine Service Endpoints (Placeholders)
URL_DETECTION_ENGINE_URL=http://localhost:5001/api/v1/detect-url
SMS_DETECTION_ENGINE_URL=http://localhost:5002/api/v1/detect-sms
